rules_version = '2';

// ===============================================================
// Assumed Data Model (Documented for /contacts/{contactId}/wa_events/{eventId})
// ===============================================================
//
// Subcollection: contacts/{contactId}/wa_events/{eventId}
// Document ID: Deterministic ({prefix}_{contactId}_{cleanMsgId|ts}) or auto-generated
// Fields (WaEvent - TASK-007B):
//   - id: string (optional, <= 200 chars) - event identifier
//   - contactId: string (optional if omitted by REST, <= 128 chars, must equal path {contactId})
//   - direction: string (required, 'inbound' | 'outbound')
//   - channel: string (optional, 1..40 chars, e.g. 'waba')
//   - messageType: string (optional, 1..40 chars, e.g. 'text', 'image', 'document', 'audio')
//   - messageId: string (optional, <= 200 chars) - Meta wamid or external ID
//   - fromPhone: string (optional, <= 64 chars)
//   - toPhone: string (optional, <= 64 chars)
//   - recipientPhoneId: string (optional, <= 64 chars)
//   - recipientDisplayPhone: string (optional, <= 64 chars)
//   - text: string (optional, <= 20000 chars)
//   - summary: string (optional, <= 2000 chars)
//   - timestampMs: number (required, > 0) - epoch milliseconds used for orderBy('timestampMs', 'desc')
//   - attachments: list<WaAttachment> (optional, <= 20 items) - Storage references
//   - hasAttachments: bool (optional)
//   - binnacleId: string (optional, <= 200 chars)
//   - createdAt: number | timestamp (optional, > 0 if number)
//   - updatedAt: number | timestamp (optional, > 0 if number)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidUrl(url) {
      return url is string &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidOptionalTimestampOrMs(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] is timestamp ||
        (request.resource.data[field] is number && request.resource.data[field] > 0);
    }

    function isValidWaAttachment(att) {
      return att is map &&
        att.keys().hasAll(['url', 'path', 'mimeType', 'filename']) &&
        att.keys().hasOnly(['url', 'path', 'mimeType', 'filename', 'sizeBytes', 'mediaType']) &&
        isValidUrl(att.url) && att.url.size() <= 2048 &&
        att.path is string && att.path.size() > 0 && att.path.size() <= 512 &&
        att.mimeType is string && att.mimeType.size() > 0 && att.mimeType.size() <= 128 &&
        att.filename is string && att.filename.size() > 0 && att.filename.size() <= 255 &&
        (!('sizeBytes' in att) || (att.sizeBytes is number && att.sizeBytes >= 0 && att.sizeBytes <= 26214400)) &&
        (!('mediaType' in att) || (att.mediaType is string && att.mediaType.size() <= 40));
    }

    // Domain Validator for /contacts/{contactId}/wa_events/{eventId}
    function isValidWaEvent(contactId) {
      let data = request.resource.data;
      return data.keys().hasAll(['direction', 'timestampMs']) &&
        data.direction in ['inbound', 'outbound'] &&
        data.timestampMs is number && data.timestampMs > 0 &&
        (!('contactId' in data) || (data.contactId is string && data.contactId == contactId && data.contactId.size() > 0 && data.contactId.size() <= 128)) &&
        isValidOptionalString('id', 1, 200) &&
        isValidOptionalString('channel', 1, 40) &&
        isValidOptionalString('messageType', 1, 40) &&
        isValidOptionalString('messageId', 0, 200) &&
        isValidOptionalString('fromPhone', 0, 64) &&
        isValidOptionalString('toPhone', 0, 64) &&
        isValidOptionalString('recipientPhoneId', 0, 64) &&
        isValidOptionalString('recipientDisplayPhone', 0, 64) &&
        isValidOptionalString('text', 0, 20000) &&
        isValidOptionalString('summary', 0, 2000) &&
        isValidOptionalString('binnacleId', 0, 200) &&
        (!('hasAttachments' in data) || data.hasAttachments is bool) &&
        (!('attachments' in data) || (
          data.attachments is list &&
          data.attachments.size() <= 20 &&
          (data.attachments.size() == 0 || isValidWaAttachment(data.attachments[0]))
        )) &&
        isValidOptionalTimestampOrMs('createdAt') &&
        isValidOptionalTimestampOrMs('updatedAt');
    }

    // 📅 Colección de Tareas y Agenda (todos):
    // Permitir lectura y escritura abierta para posibilitar la sincronización en segundo plano
    // desde endpoints serverless (Vercel / n8n / Google Tasks & Calendar) y clientes autenticados.
    match /todos/{todoId} {
      allow read, write: if true;
    }

    // 👤 Perfiles de usuario: Solo lectura/escritura autenticada
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 📇 Contactos y Prospectos: Lectura y escritura abierta para posibilitar
    // ingesta ágil en campo (15s), acceso rápido admin y sincronizaciones n8n
    match /contacts/{contactId} {
      allow read, write: if true;

      // 💬 Eventos de WhatsApp y referencias de adjuntos en Storage (TASK-007B):
      // Lectura y escritura abierta (con validación estructural) para cliente ATAIR,
      // /api/whatsapp/inbound (Vercel sin Firebase Auth) y webhooks n8n (Firestore REST API).
      match /wa_events/{eventId} {
        allow read: if true;
        allow create, update: if isValidWaEvent(contactId);
        allow delete: if true;
      }
    }

    // 🏠 Propiedades: Lectura pública (catálogo) y actualización
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // 📝 Bitácoras: Trazabilidad comercial viva
    match /binnacles/{binnacleId} {
      allow read, write: if true;
    }

    // 📁 Trámites y Expedientes Inmobiliarios: Lectura y escritura abierta para
    // gestión en campo, quickAdminLogin y sincronización paramétrica desde ATAIR
    match /tramites/{tramiteId} {
      allow read, write: if true;
    }

    // Regla de salvaguarda para el resto de colecciones
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
