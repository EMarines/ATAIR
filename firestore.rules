rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 📅 Colección de Tareas y Agenda (todos):
    // Permitir lectura y escritura abierta para posibilitar la sincronización en segundo plano
    // desde endpoints serverless (Vercel / n8n / Google Tasks & Calendar) y clientes autenticados.
    match /todos/{todoId} {
      allow read, write: if true;
    }

    // 👤 Perfiles de usuario: Solo lectura/escritura autenticada
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // 📇 Contactos y Prospectos: Lectura y escritura abierta para posibilitar
    // ingesta ágil en campo (15s), acceso rápido admin y sincronizaciones n8n
    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // 🏠 Propiedades: Lectura pública (catálogo) y actualización
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // 📝 Bitácoras: Trazabilidad comercial viva
    match /binnacles/{binnacleId} {
      allow read, write: if true;
    }

    // Regla de salvaguarda para el resto de colecciones
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
