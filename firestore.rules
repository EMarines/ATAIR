rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 📅 Colección de Tareas y Agenda (todos):
    // Permitir lectura y escritura abierta para posibilitar la sincronización en segundo plano
    // desde endpoints serverless (Vercel / n8n / Google Tasks & Calendar) y clientes autenticados.
    match /todos/{todoId} {
      allow read, write: if true;
    }

    // 👤 Perfiles de usuario: Solo lectura/escritura autenticada
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // 📇 Contactos y Prospectos: Solo lectura/escritura autenticada
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // 🏠 Propiedades: Lectura pública (catálogo), escritura autenticada
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 📝 Bitácoras: Solo lectura/escritura autenticada
    match /binnacles/{binnacleId} {
      allow read, write: if request.auth != null;
    }

    // Regla de salvaguarda para el resto de colecciones
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
